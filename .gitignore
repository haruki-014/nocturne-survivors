# ─────────────────────────────────────────────
#  Nocturne Survivors ── Git 管理から除外するもの
#  (生成物・依存・OS/エディタの副産物。ソースと設定のみを追跡する)
# ─────────────────────────────────────────────

# --- Node / フロントエンド依存 ---
node_modules/
.pnp
.pnp.js

# --- ビルド成果物 ---
dist/
dist-ssr/
build/
*.local

# --- Vite / ツールのキャッシュ ---
.vite/
.cache/
*.tsbuildinfo

# --- Tauri / Rust(src-tauri) ---
# Rust のビルド成果物(数 GB)。再生成可能なので追跡しない。
src-tauri/target/
# Tauri が生成するスキーマ/権限ファイル。
src-tauri/gen/
# 配布バンドル(.app/.dmg 等)。
src-tauri/**/bundle/

# --- ログ ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# --- 環境変数・秘密情報 ---
.env
.env.*
!.env.example

# --- OS の副産物 ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- エディタ / IDE ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Claude Code(共有設定は残し、ローカル設定のみ除外) ---
.claude/settings.local.json
